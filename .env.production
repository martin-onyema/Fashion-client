# ============================================================
# Wardrobecare — PRODUCTION environment template
#
# This file ships with the code for reference. On Vercel you do NOT
# commit secrets: paste each variable in
#   Vercel Dashboard -> Settings -> Environment Variables
# See DEPLOY.md section 2 for the full walkthrough.
# ============================================================

# --- Database (Supabase Postgres, use the POOLER connection string) ---
# Supabase Dashboard -> Project Settings -> Database -> Connection pooling
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="paste-openssl-rand-base64-32-output-here"
# The exact URL visitors browse. While your domain is not yet connected,
# set this to your vercel.app URL, then change it after connecting
# wardrobecare.com.ng (and redeploy). Mismatching this with the browser URL
# silently breaks ALL logins (admin and customer).
NEXTAUTH_URL="https://wardrobecare.com.ng"

# --- Secret admin route (NEW — hides the admin console) ---
# The admin console at /admin returns 404 to everyone who is not staff.
# You reach it ONLY through this secret path, e.g.:
#   https://wardrobecare.com.ng/wardrobe-hq-9xk2
# Change it to any private value you like (starts with "/", never "/admin").
ADMIN_ACCESS_PATH="/wardrobe-hq-9xk2"

# --- Transactional email (Resend) — domain already verified ---
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Wardrobecare <codes@wardrobecare.com.ng>"

# --- Paystack (live keys) ---
PAYSTACK_PUBLIC_KEY="pk_live_xxxxxxxxxxxxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxxxxxx"
